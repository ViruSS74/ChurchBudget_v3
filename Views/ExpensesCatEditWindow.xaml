<Window x:Class="ChurchBudget_v3_WPF.Views.ExpensesCatEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChurchBudget_v3_WPF.Views"
        mc:Ignorable="d"
        Title="Карточка Категорий расходов" Height="350" Width="600"
        MinHeight="350" MinWidth="550"
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/main_icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Background="{StaticResource ChurchBgColor}" BorderBrush="{StaticResource ChurchWindowBorderColor}" BorderThickness="1">
        <DockPanel>
            <!-- 1. ШАПКА ОКНА -->
            <Border DockPanel.Dock="Top" Background="{StaticResource ChurchHeaderColor}" Padding="8" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Image Source="/main_icon.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Карточка категории расходов прихода" Style="{StaticResource ChurchHeaderTitleStyle}"/>
                    </StackPanel>
                    <Button Content="X" Style="{StaticResource WindowCloseButtonStyle}" HorizontalAlignment="Right" Click="CloseButton_Click"/>
                </Grid>
            </Border>
            <!-- 2. НИЖНЯЯ ПАНЕЛЬ -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource ChurchFooterColor}" Padding="12" BorderBrush="#DCDCDC" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Width="120" Height="32" Margin="0,0,10,0" Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Graph/Icons/save.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Сохранить"/>
                        </StackPanel>
                    </Button>
                    <Button Width="120" Height="32" Margin="0,0,10,0" Click="CloseButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Graph/Icons/cancel.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Отменить"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <!-- 3. КАРТОЧКА ВВОДА -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="15">
                    <GroupBox Header=" Данные категории расходов " Padding="15" FontSize="13" FontWeight="Bold">
                        <Grid VerticalAlignment="Top" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Родительская:" Margin="0,0,15,15"/>
                            <TextBox Name="txtParentName" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Background="#F5F5F5" Foreground="#555555" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование:" Margin="0,0,15,5"/>
                            <TextBox Name="txtCategoryName" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
