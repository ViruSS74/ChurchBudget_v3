<Window x:Class="ChurchBudget_v3_WPF.Views.IncomeCatEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChurchBudget_v3_WPF.Views"
        mc:Ignorable="d"
        Title="Карточка Категорий доходов" Height="350" Width="600"
        MinHeight="300" MinWidth="500"
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/main_icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    
    <Border Background="{StaticResource ChurchBgColor}" BorderBrush="{StaticResource ChurchWindowBorderColor}" BorderThickness="1">
        <DockPanel>
            <!-- 1. ШАПКА ОКНА -->
            <Border DockPanel.Dock="Top" Background="{StaticResource ChurchHeaderColor}" Padding="8" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Image Source="/main_icon.ico" 
                           Width="20" 
                           Height="20" 
                           Margin="0,0,10,0" 
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Исправлено название шапки -->
                        <TextBlock Text="Карточка категории доходов" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Width="45" HorizontalAlignment="Right" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#013270"/>
                                <Setter Property="FontFamily" Value="Marlett"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        X
                    </Button>
                </Grid>
            </Border>
            <!-- 2. НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ УПРАВЛЕНИЯ -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource ChurchFooterColor}" Padding="12" BorderBrush="#DCDCDC" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Width="120" Height="32" Margin="0,0,10,0" Click="SaveButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="/Graph/Icons/save.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="120" Height="32" Margin="0,0,10,0" Click="CloseButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="/Graph/Icons/cancel.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Отменить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- 3. ЦЕНТРАЛЬНАЯ РАБОЧАЯ ОБЛАСТЬ С ДОБАВЛЕННЫМ СКРОЛЛЕРОМ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="15">
                    <!-- Исправлен заголовок GroupBox -->
                    <GroupBox Header=" Данные категории дохода " Padding="15" FontSize="13" FontWeight="Bold">
                        <Grid VerticalAlignment="Top" Margin="5,10,5,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Родительская категория -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="Родительская:" 
                               VerticalAlignment="Center" 
                               FontSize="14" 
                               Margin="0,0,15,15"/>
                            <TextBox Name="txtParentName" 
                               Grid.Row="0" Grid.Column="1" 
                               Height="28" 
                               FontSize="14" 
                               VerticalContentAlignment="Center" 
                               IsReadOnly="True" 
                               Background="#F5F5F5" 
                               Foreground="#555555"
                               Margin="0,0,0,15"
                               Padding="5,0"/>

                            <!-- Наименование категории дохода -->
                            <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="Наименование:" 
                               VerticalAlignment="Center" 
                               FontSize="14" 
                               Margin="0,0,15,15"/>
                            <TextBox Name="txtCategoryName" 
                               Grid.Row="1" Grid.Column="1" 
                               Height="28" 
                               FontSize="14" 
                               VerticalContentAlignment="Center" 
                               Margin="0,0,0,15"
                               Padding="5,0"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
