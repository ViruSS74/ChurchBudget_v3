<Window x:Class="ChurchBudget_v3_WPF.Views.IDDocsEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChurchBudget_v3_WPF.Views"
        mc:Ignorable="d"
        Title="Карточка ИД Документов" Height="450" Width="600"
        MinHeight="450" MinWidth="550"
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/main_icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Background="{StaticResource ChurchBgColor}" BorderBrush="{StaticResource ChurchWindowBorderColor}" BorderThickness="1">
        <DockPanel>
            <!-- 1. ИСПРАВЛЕННАЯ ШАПКА ОКНА -->
            <Border DockPanel.Dock="Top" Background="{StaticResource ChurchHeaderColor}" Padding="8" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Image Source="/main_icon.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Карточка ИД документа сотрудника" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Width="45" HorizontalAlignment="Right" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#013270"/>
                                <Setter Property="FontFamily" Value="Marlett"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        X
                    </Button>
                </Grid>
            </Border>

            <!-- 2. НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ УПРАВЛЕНИЯ -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource ChurchFooterColor}" Padding="12" BorderBrush="#DCDCDC" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Width="120" Height="32" Margin="0,0,10,0" Click="SaveButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="/Graph/Icons/save.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="120" Height="32" Margin="0,0,10,0" Click="CloseButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="/Graph/Icons/cancel.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Отменить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. СТРАХОВОЧНЫЙ СКРОЛЛЕР ДЛЯ КАРТОЧКИ С 6 ПОЛЯМИ ВВОДА -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="15">
                    <GroupBox Header=" Данные ИД документа " Padding="15" FontSize="13" FontWeight="Bold">
                        <Grid VerticalAlignment="Top" Margin="5,5,5,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Сотрудник -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Сотрудник:" VerticalAlignment="Center" FontSize="14" Margin="0,0,15,15"/>
                            <ComboBox Name="cmbEmployee" Grid.Row="0" Grid.Column="1" Height="28" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" DisplayMemberPath="FullFIO" SelectedValuePath="id"/>

                            <!-- Тип документа -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип документа:" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,15"/>
                            <ComboBox Name="cmbTypeIDDoc" Grid.Row="1" Grid.Column="1" Height="28" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" DisplayMemberPath="name" SelectedValuePath="id"/>

                            <!-- Серия -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Серия:" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,15"/>
                            <TextBox Name="txtSeries" Grid.Row="2" Grid.Column="1" Height="28" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" Padding="5,0"/>

                            <!-- Номер -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Номер:" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,15"/>
                            <TextBox Name="txtNumber" Grid.Row="3" Grid.Column="1" Height="28" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" Padding="5,0"/>

                            <!-- Кем выдан -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Кем выдан:" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,15"/>
                            <TextBox Name="txtIssuedBy" Grid.Row="4" Grid.Column="1" Height="28" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" Padding="5,0"/>

                            <!-- Дата выдачи -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Дата выдачи:" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,5"/>
                            <DatePicker Name="dpIssueDate" SelectedDateFormat="Short" Grid.Row="5" Grid.Column="1" Height="28" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,5"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
