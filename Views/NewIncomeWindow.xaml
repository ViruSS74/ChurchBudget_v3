<Window x:Class="ChurchBudget_v3_WPF.Views.NewIncomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChurchBudget_v3_WPF.Views"
        mc:Ignorable="d"
        Title="Новый приходный документ. Рапортичка" Height="660" Width="1150"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/main_icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Background="{StaticResource ChurchBgColor}" BorderBrush="{StaticResource ChurchWindowBorderColor}" BorderThickness="1">
        <DockPanel>
            <!-- 1. ШАПКА ОКНА -->
            <Border DockPanel.Dock="Top" Background="{StaticResource ChurchHeaderColor}" Padding="8" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Image Source="/main_icon.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Новый приходный документ" Style="{StaticResource ChurchHeaderTitleStyle}"/>
                    </StackPanel>
                    <Button Content="X" Style="{StaticResource WindowCloseButtonStyle}" HorizontalAlignment="Right" Click="CloseButton_Click"/>
                </Grid>
            </Border>
            <!-- 2. НИЖНЯЯ ПАНЕЛЬ -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource ChurchFooterColor}" Padding="12" BorderBrush="#DCDCDC" BorderThickness="0,1,0,0">
                <Grid>
                    <Button Width="120" Height="32" HorizontalAlignment="Left" Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Graph/Icons/save.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Сохранить"/>
                        </StackPanel>
                    </Button>
                    <Button Width="120" Height="32" HorizontalAlignment="Right" Click="CloseButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Graph/Icons/exit.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Закрыть"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <!-- 3. ЦЕНТРАЛЬНАЯ РАБОЧАЯ ОБЛАСТЬ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="15,10,15,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Строка 0: Системные поля -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                            <TextBlock Text="Номер документа:" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBox Name="txtDocNumber" Width="150" FontWeight="SemiBold" IsReadOnly="True" Background="#F5F5F5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Дата:" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"/>
                            <DatePicker Name="dpDocDate" Width="180"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Строка 1: ФИО и Основание -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="ФИО (выберите из списка или введите вручную):" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ComboBox Name="cmbMainPerson" IsEditable="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Vertical">
                            <TextBlock Text="Общее основание документа:" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Name="txtMainBasis"/>
                        </StackPanel>
                    </Grid>
                    <!-- Строка 2: Табличная часть -->
                    <Grid Grid.Row="2" Margin="0,5,0,0" MinHeight="300" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Дерево категорий -->
                        <Border Grid.Column="0" BorderBrush="{StaticResource ChurchWindowBorderColor}" BorderThickness="1" Background="White">
                            <TreeView Name="tvCategories" BorderThickness="0" FontSize="14">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <EventSetter Event="MouseDoubleClick" Handler="dgCategories_MouseDoubleClick"/>
                                        <Setter Property="FontFamily" Value="{StaticResource ChurchFont}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,4,2,4">
                                            <TextBlock Text="{Binding name}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                        <!-- Таблица добавленных сумм -->
                        <DataGrid Name="dgDocumentItems" 
                                  Grid.Column="2" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  IsReadOnly="False" 
                                  SelectionMode="Single" 
                                  FontSize="14" 
                                  HeadersVisibility="Column" 
                                  CellEditEnding="dgDocumentItems_CellEditEnding" 
                                  PreparingCellForEdit="dgDocumentItems_PreparingCellForEdit">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" IsReadOnly="True" Width="2*"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N2\}}" IsReadOnly="False" Width="1*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="0,0,8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Примечание" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="2.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <!-- Строка 3: Итого -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,15,5">
                        <TextBlock Text="Итого: " FontSize="15" FontWeight="Bold"/>
                        <TextBlock Name="txtTotalAmount" Text="0,00" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text=" руб." FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
