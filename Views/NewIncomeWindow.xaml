<Window x:Class="ChurchBudget_v3_WPF.Views.NewIncomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChurchBudget_v3_WPF.Views"
        mc:Ignorable="d"
        Title="Новый приходный документ" Height="660" Width="1150"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/main_icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Background="{StaticResource ChurchBgColor}" BorderBrush="{StaticResource ChurchWindowBorderColor}" BorderThickness="1">
        <DockPanel>
            <!-- 1. ШАПКА ОКНА -->
            <Border DockPanel.Dock="Top" Background="{StaticResource ChurchHeaderColor}" Padding="8" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Image Source="/main_icon.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Новый приходный документ" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Width="45" HorizontalAlignment="Right" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#013270"/>
                                <Setter Property="FontFamily" Value="Marlett"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        X
                    </Button>
                </Grid>
            </Border>

            <!-- 2. НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ УПРАВЛЕНИЯ -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource ChurchFooterColor}" Padding="12" BorderBrush="#DCDCDC" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Width="120" Height="32" Margin="0,0,10,0" Click="SaveButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="/Graph/Icons/save.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Width="120" Height="32" HorizontalAlignment="Right" Click="CloseButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="/Graph/Icons/exit.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Закрыть" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. СТРАХОВОЧНЫЙ СКРОЛЛЕР ДЛЯ НОУТБУКОВ -->
            <!-- Отключаем горизонтальное раздувание сетки -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- ЦЕНТРАЛЬНАЯ РАБОЧАЯ ОБЛАСТЬ -->
                <Grid Margin="15,10,15,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ================= ВЕРХНЯЯ ПАНЕЛЬ: СТРОКА 0 (Системные поля) ================= -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                            <TextBlock Text="Номер документа:" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Name="txtDocNumber" Width="150" Height="28" FontSize="14" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="5,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Дата:" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker Name="dpDocDate" Width="180" Height="28" FontSize="14" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ================= СТРОКА 1: ПОЛЯ ФИО (ComboBox) и Основание ================= -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- КЛИЕНТ / СОТРУДНИК (Заменили TextBox на ComboBox) -->
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="ФИО (выберите из списка или введите вручную):" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <!-- IsEditable позволяет как выбирать из списка, так и писать руками -->
                            <ComboBox Name="cmbMainPerson" 
                  Height="28" 
                  FontSize="14" 
                  IsEditable="True"
                  VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Общее основание (Остается без изменений) -->
                        <StackPanel Grid.Column="2" Orientation="Vertical">
                            <TextBlock Text="Общее основание документа:" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Name="txtMainBasis" Height="28" FontSize="14" VerticalContentAlignment="Center" Padding="5,0"/>
                        </StackPanel>
                    </Grid>


                    <!-- ================= ТАБЛИЧНАЯ ЧАСТЬ (Строка 2) ================= -->
                    <Grid Grid.Row="2" Margin="0,5,0,0" MinHeight="300" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>
                        <!-- ЛЕВАЯ СТОРОНА: Справочник категорий -->
                        <Border Grid.Column="0" BorderBrush="{StaticResource ChurchWindowBorderColor}" BorderThickness="1" Background="White">
                            <TreeView Name="tvCategories" BorderThickness="0" FontSize="14">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <EventSetter Event="MouseDoubleClick" Handler="dgCategories_MouseDoubleClick"/>
                                        <Setter Property="FontFamily" Value="{StaticResource ChurchFont}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,4,2,4">
                                            <TextBlock Text="{Binding name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                        <!-- ПРАВАЯ СТОРОНА: Таблица добавленных сумм -->
                        <DataGrid Name="dgDocumentItems" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" Background="{StaticResource ChurchGridBg}" RowBackground="{StaticResource ChurchGridRowAlternating}" AlternatingRowBackground="{StaticResource ChurchGridRowNormal}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource ChurchWindowBorderColor}" FontSize="14" HeadersVisibility="Column" CellEditEnding="dgDocumentItems_CellEditEnding" PreparingCellForEdit="dgDocumentItems_PreparingCellForEdit">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="8,6,8,6"/>
                                    <Setter Property="BorderBrush" Value="#DCDCDC"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" IsReadOnly="True" Width="2*"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N2\}}" IsReadOnly="False" Width="1*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="0,0,8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Примечание" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="2.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- ================= СТРОКА ИТОГА (Строка 3, под таблицами) ================= -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,15,5">
                        <TextBlock Text="Итого: " FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Name="txtTotalAmount" Text="0,00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" руб." FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
