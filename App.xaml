<Application x:Class="ChurchBudget_v3_WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChurchBudget_v3_WPF"
             xmlns:services="clr-namespace:ChurchBudget_v3_WPF.Services">

    <Application.Resources>
        <!-- ========================================== -->
        <!-- ВАША ПАЛИТРА (Меняйте HEX-коды здесь)      -->
        <!-- ========================================== -->
        <SolidColorBrush x:Key="ChurchBgColor" Color="#D3D3D3"/>
        <!-- Фон окон -->
        <SolidColorBrush x:Key="ChurchHeaderColor" Color="#8FA882"/>
        <!-- Фон заголовков -->
        <SolidColorBrush x:Key="ChurchFooterColor" Color="#D3E2CD"/>
        <!-- Фон панели с кнопками -->
        <SolidColorBrush x:Key="ChurchHeaderTabColor" Color="#D3E2CD"/>
        <!-- Фон шапок -->
        <SolidColorBrush x:Key="ChurchTextColor" Color="#013270"/>
        <!-- Основной синий текст -->
        <SolidColorBrush x:Key="ChurchWindowBorderColor" Color="#013270"/>
        <!-- Цвет рамки окон -->
        <!-- Оформление таблицы -->
        <SolidColorBrush x:Key="ChurchGridBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ChurchGridRowNormal" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ChurchGridRowAlternating" Color="#FAFAFA"/>

        <!-- ==Цвета для кнопок== -->
        <SolidColorBrush x:Key="BtnActiveBg" Color="#8FA882"/>
        <!-- Фон обычной кнопки -->
        <SolidColorBrush x:Key="BtnHoverBg" Color="#F0F4F8"/>
        <!-- Фон при наведении мыши -->
        <SolidColorBrush x:Key="BtnDisabledBg" Color="#B2C2AD"/>
        <!-- Фон отключенной кнопки -->
        <SolidColorBrush x:Key="BtnDisabledText" Color="#556B4E"/>
        <!-- Текст отключенной кнопки -->

        <!-- Главный шрифт проекта -->
        <FontFamily x:Key="ChurchFont">Georgia</FontFamily>

        <!-- ========================================== -->
        <!-- АВТОМАТИЧЕСКИЕ СТИЛИ ДЛЯ ВСЕХ ОКОН         -->
        <!-- ========================================== -->

        <Style x:Key="ChurchHeaderTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 1. Стиль для Окон -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="{StaticResource ChurchFont}" />
            <Setter Property="Background" Value="{StaticResource ChurchBgColor}" />
        </Style>

        <!-- 2. Стиль для Текста -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource ChurchFont}" />
            <Setter Property="Foreground" Value="{StaticResource ChurchTextColor}" />
        </Style>

        <!-- 3. Стиль для Шапки Таблиц (DataGrid) -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="FontFamily" Value="{StaticResource ChurchFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{StaticResource ChurchHeaderColor}" />
            <Setter Property="Foreground" Value="{StaticResource ChurchTextColor}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="{x:Type DataGridRowHeader}">
            <Setter Property="Background" Value="#D3E2CD"/>
            <Setter Property="Foreground" Value="{StaticResource ChurchTextColor}"/>
            <Setter Property="FontFamily" Value="{StaticResource ChurchFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="35"/>
        </Style>

        <!-- 4. Идеальный шаблон для Кнопок -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="{StaticResource ChurchFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource ChurchTextColor}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                            Background="{StaticResource BtnActiveBg}" 
                            CornerRadius="4" 
                            BorderBrush="{StaticResource ChurchTextColor}"
                            BorderThickness="1"
                            Padding="12,5">
                            <ContentPresenter x:Name="contentPresenter" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Эффект при наведении -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BtnHoverBg}"/>
                            </Trigger>
                            <!-- Поведение, когда кнопка отключена (IsEnabled="False") -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BtnDisabledBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource BtnDisabledText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        

    </Application.Resources>
</Application>
