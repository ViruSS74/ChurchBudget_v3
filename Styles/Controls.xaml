<ResourceDictionary 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 1. Стиль для Окон -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="{StaticResource ChurchFont}" />
        <Setter Property="Background" Value="{StaticResource ChurchBgColor}" />
    </Style>

    <!-- 2. Стиль для Текста -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource ChurchFont}" />
        <Setter Property="Foreground" Value="{StaticResource ChurchTextColor}" />
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ChurchHeaderTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ОПТИМИЗАЦИЯ: Добавляем автоматические высоты и шрифты для полей ввода (чтобы убрать дублирование в окнах) -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource ChurchFont}" />
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="5,0"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource ChurchFont}" />
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MaxDropDownHeight" Value="300"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    </Style>

    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="FontFamily" Value="{StaticResource ChurchFont}" />
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 3. Стили для Таблиц (DataGrid) -->
    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="FontFamily" Value="{StaticResource ChurchFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="{StaticResource ChurchHeaderColor}" />
        <Setter Property="Foreground" Value="{StaticResource ChurchTextColor}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style TargetType="{x:Type DataGridRowHeader}">
        <Setter Property="Background" Value="#D3E2CD"/>
        <Setter Property="Foreground" Value="{StaticResource ChurchTextColor}"/>
        <Setter Property="FontFamily" Value="{StaticResource ChurchFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Width" Value="35"/>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource ChurchGridBg}"/>
        <Setter Property="RowBackground" Value="{StaticResource ChurchGridRowNormal}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource ChurchGridRowAlternating}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ChurchWindowBorderColor}"/>
    </Style>
</ResourceDictionary>